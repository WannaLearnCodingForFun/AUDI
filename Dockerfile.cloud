# AUDI Cloud DB service: authoritative memory (Postgres) + observation images (S3-compatible).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# the cloud service needs no ML stack: only its own imports
RUN pip install "fastapi>=0.110" "uvicorn[standard]>=0.27" "sqlalchemy>=2" "pydantic>=2" "python-jose[cryptography]>=3.3" \
    "passlib[bcrypt]>=1.7.4" "bcrypt>=4.0.1,<4.1" "PyYAML>=6" "httpx>=0.25" "python-multipart>=0.0.9" "psycopg[binary]>=3.1" "boto3>=1.34" \
    "numpy>=1.24" "opencv-python-headless>=4.8" "Pillow>=9.5"
COPY auth ./auth
COPY cloud ./cloud
COPY memory ./memory
COPY ml ./ml
COPY config.yaml ./
RUN useradd -m -u 10001 audi && mkdir -p /app/data && chown -R audi /app/data
USER audi
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fs http://127.0.0.1:8100/cloud/health || exit 1
CMD ["python", "-c", "import uvicorn; from cloud.main import create_app; uvicorn.run(create_app(), host='0.0.0.0', port=8100)"]
