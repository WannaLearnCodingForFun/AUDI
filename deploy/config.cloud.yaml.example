# Copy to deploy/config.cloud.yaml: the repository config.yaml with the cloud-mode overrides below.
# (python scripts/make_cloud_config.py writes it for you.)
cloud:
  base_url: "http://cloud:8100"
  server:
    host: "0.0.0.0"
    object_store: {kind: "s3", bucket_env: "AUDI_S3_BUCKET", endpoint_env: "AUDI_S3_ENDPOINT", region_env: "AWS_REGION", prefix: "audi"}
api:
  host: "0.0.0.0"
  cors_origins: ["https://audi.example.org"]
security:
  encrypt_images: true
  rate_limit_per_minute: 600
observability:
  json_logs: true
