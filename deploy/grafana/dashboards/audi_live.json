{
 "title": "AUDI live mission",
 "uid": "audi-live",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Live session",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_live_running"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Processed fps",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_live_processed_fps"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Alert latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_live_latency_p95_ms{stage=\"alert\"}"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Outbox queue",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_outbox_pending"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Cloud online",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_cloud_online"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Assets in memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_assets"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Live fps",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_live_processed_fps",
     "legendFormat": "processed"
    },
    {
     "refId": "B",
     "expr": "audi_live_capture_fps",
     "legendFormat": "captured"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Live latency p95 by stage",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_live_latency_p95_ms",
     "legendFormat": "{{stage}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Outbox queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_outbox_pending",
     "legendFormat": "pending"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Frames (rate)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(audi_live_frames{counter=~\"processed|skipped_duplicate|rejected_quality|alerts\"}[1m])",
     "legendFormat": "{{counter}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "HTTP p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(audi_http_request_duration_ms_bucket[5m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "HTTP errors & rate limiting",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(audi_http_requests_total{status=~\"4..|5..\"}[5m]))",
     "legendFormat": "{{status}}"
    },
    {
     "refId": "B",
     "expr": "rate(audi_rate_limited_total[5m])",
     "legendFormat": "rate-limited"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Quality gate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "audi_quality_gate",
     "legendFormat": "{{reason}}"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 }
}